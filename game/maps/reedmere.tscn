dialogue_done = Array[String](["Bệnh thì uống thuốc tím, hết thuốc tím thì... mẹ em bảo nằm im chờ triều rút.", "Anh/chị có thấy tên em trong sổ thuốc không? Em không biết chữ, nhưng em thuộc hết tên người trong làng."])
