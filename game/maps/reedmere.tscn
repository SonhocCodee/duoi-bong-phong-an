[node name="NPC_DanSay" type="CharacterBody2D" parent="." instance=ExtResource("18_llvsb")]
y_sort_enabled = true
position = Vector2(416, 224)
script = ExtResource("19_1fsmg")
npc_id = "dan_say_1"
display_name = "Dân làng Sậy"
quest_ids = Array[String](["nam_03a_pha_vuon", "nam_03b_ghi_chung_cu", "nam_side_herb"])
dialogue_before = Array[String](["Ngươi hỏi chuyện vườn nấm ở Venomfen à? Giáo phái trồng nấm độc ngay cạnh đường, ếch canh ngày đêm.", "Phá vườn thì làng mất nguồn thuốc lẫn lộn, để nguyên thì chúng còn thử thuốc lên người. Ngươi tự quyết — ta chỉ giữ chứng cứ giúp ngươi thôi."])
dialogue_active = Array[String](["Venomfen ở phía tây-nam, qua Drownedwood. Đầm độc lắm, nhìn chỗ nấm phát sáng mà tránh."])
dialogue_ready = Array[String](["Ngươi mang được tin về rồi à? Kể ta nghe, ta ghi lại hết vào sổ của làng."])
dialogue_done = Array[String](["Dân Reedmere này sống bằng sậy và cá. Từ ngày có 'thuốc' của giáo phái, sống thêm một thứ nữa: nợ."])
shop_enabled = false
tint = Color(0.8, 0.95, 0.85, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
