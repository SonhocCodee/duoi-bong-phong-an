[node name="NPC_TruongReedmere" type="CharacterBody2D" parent="." instance=ExtResource("18_llvsb")]
y_sort_enabled = true
position = Vector2(-224, -96)
script = ExtResource("19_1fsmg")
npc_id = "truong_reedmere"
display_name = "Trưởng làng Reedmere"
quest_ids = Array[String](["nam_01_den_fenmire", "nam_06c_pha_chu_ky"])
dialogue_before = Array[String](["Chào ngươi tới Reedmere. Thấy thùng thuốc của làng ta không? Giáo phái hứa phát thuốc, mà Đỉa Bùn chặn mất đường ở bìa Drownedwood.", "Diệt giúp ta 3 con Đỉa Bùn giữ đường. Thuốc về được làng, người bệnh mới có cửa sống."])
dialogue_active = Array[String](["Đỉa Bùn ở bìa đông Drownedwood, chỗ nước tù có bầy đỉa. Cẩn thận, chúng trâu lắm."])
dialogue_ready = Array[String](["Thuốc về làng rồi! Ngươi không biết mình vừa cứu bao nhiêu người đâu."])
dialogue_done = Array[String](["Reedmere nhớ ơn ngươi. Nhưng nhớ lấy: thuốc của giáo phái lúc nào cũng kèm một cái sổ — và tên dân làng ta nằm trong đó."])
shop_enabled = false
tint = Color(0.95, 0.9, 0.8, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
"action": "idle",
"time": 6.0,
"x": -224.0,
