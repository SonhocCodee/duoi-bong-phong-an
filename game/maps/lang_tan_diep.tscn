[node name="NPC_TruongLang" type="CharacterBody2D" parent="." instance=ExtResource("7_npc")]
y_sort_enabled = true
position = Vector2(-285, -70)
script = ExtResource("8_eushh")
npc_id = "truong_lang"
display_name = "Trưởng làng Elmford"
quest_ids = Array[String](["dong_01_goblin", "dong_05_tram_thue"])
dialogue_before = Array[String](["Goblin kéo về bìa rừng phía đông, phá rẫy, dọa trẻ con trong làng.", "Ngươi còn trẻ, nhưng tay kiếm có vẻ chắc. Dẹp giúp làng 3 con goblin, được không?"])
dialogue_active = Array[String](["Goblin ở bìa rừng phía đông làng. Cẩn thận, chúng đi theo bầy."])
dialogue_ready = Array[String](["Nghe nói ngươi đã dẹp xong bầy goblin? Tốt lắm!"])
dialogue_done = Array[String](["Elmford nhờ ngươi mà yên ổn. Muốn đi xa, cứ theo đường bắc lên Barleyfield, rồi tới Aldenmere."])
shop_enabled = false
tint = Color(1, 0.9, 0.75, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
