dialogue_before = Array[String]([])
dialogue_active = Array[String]([])
dialogue_ready = Array[String]([])
dialogue_done = Array[String](["Ngày xưa Elder Tree ở Aldenmere che bóng cả quảng trường, nghe nói rễ nó giữ cả vùng Đông này.", "Qua cổng đông là Elderwood — đẹp nhưng nhiều goblin. Đi đường bắc qua Barleyfield thì an toàn hơn."])
