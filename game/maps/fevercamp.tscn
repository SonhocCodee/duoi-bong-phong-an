[node name="NPC_BenhNhan" type="CharacterBody2D" parent="." instance=ExtResource("14_nit2c")]
y_sort_enabled = true
position = Vector2(-544, 576)
script = ExtResource("15_sr7b0")
npc_id = "benh_nhan_1"
display_name = "Ông Già Giữ Nghề Chài"
quest_ids = Array[String](["nam_02b_thuoc_gia"])
dialogue_before = Array[String](["Ta chài cá ở Blackmere bốn mươi năm. Tay ta run rồi, nhưng lưới nào rách ta còn vá được, triều nào lạ ta còn đọc được.", "Thuốc ít thì cho lớp trẻ giữ nghề cũng phải... mà đám trẻ bệnh nặng kia, chúng nó còn chưa biết chài. Khó. Ngươi quyết đi."])
dialogue_active = Array[String](["Ta chờ được. Cả đời chờ triều, chờ cá, chờ thuốc."])
dialogue_ready = Array[String](["Ngươi chọn ta à? Vậy ta phải sống cho đáng — ra khơi lại, dạy hết nghề cho đám nhỏ Reedmere."])
dialogue_done = Array[String](["Cái đầm này nuôi người bằng cá và giết người bằng nước. Giáo phái chỉ là kẻ đến sau, bán thuốc cho cả hai việc."])
shop_enabled = false
tint = Color(0.85, 0.85, 0.9, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
