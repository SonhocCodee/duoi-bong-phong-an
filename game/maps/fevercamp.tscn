[node name="NPC_MeGoa" type="CharacterBody2D" parent="." instance=ExtResource("14_nit2c")]
y_sort_enabled = true
position = Vector2(864, 576)
script = ExtResource("15_sr7b0")
npc_id = "me_goa"
display_name = "Người Mẹ Góa"
quest_ids = Array[String](["nam_02c_thuoc_nuoi_nha"])
dialogue_before = Array[String](["Chồng tôi nằm trong lều kia. Anh ấy là người duy nhất trong nhà còn gánh được nước, vá được lưới.", "Tôi không xin cho mình. Anh ấy mà gục, ba đứa nhỏ nhà tôi chết theo — chậm hơn, nhưng chắc hơn."])
dialogue_active = Array[String](["Anh ấy sốt cả đêm. Tôi đếm từng đợt triều ngoài kia mà chờ."])
dialogue_ready = Array[String](["Ơn này nhà tôi không trả nổi bằng cá đâu. Anh ấy sống lại, cả nhà tôi theo ngươi tới cùng."])
dialogue_done = Array[String](["Người ta bảo giáo phái cứu dân đầm. Đúng — họ cứu, và họ ghi sổ từng mạng một."])
