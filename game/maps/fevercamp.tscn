[node name="NPC_YSi" type="CharacterBody2D" parent="." instance=ExtResource("14_nit2c")]
y_sort_enabled = true
position = Vector2(-96, -64)
script = ExtResource("15_sr7b0")
npc_id = "y_si_tram"
display_name = "Y Sĩ Trưởng Trạm"
quest_ids = Array[String](["nam_02_danh_sach_thuoc", "nam_02a_thuoc_tre", "nam_06a_giu_thoa_thuan"])
dialogue_before = Array[String](["Ta là y sĩ của trạm này — người của giáo phái trên giấy, người của bệnh nhân ngoài đời.", "Sổ thuốc chỉ phát cho một nửa danh sách. Ngươi hái giúp ta 3 thảo dược đầm, ta sắc thuốc ngoài sổ, cứu được ai hay người đó."])
dialogue_active = Array[String](["Thảo dược mọc quanh Reedmere và Drownedwood. Đủ 3 cây mang về đây."])
dialogue_ready = Array[String](["Đủ thảo rồi. Phần thuốc này không có trong sổ của giáo phái — và ta phải chọn phát cho một nhóm thôi. Ngươi quyết thay ta: trẻ bệnh nặng, người già giữ nghề, hay người nuôi cả nhà?"])
dialogue_done = Array[String](["Mỗi lựa chọn ở đây đều để lại người không được cứu. Ta ghi hết vào sổ riêng — sau này đối chất ở Fenmire, đừng để họ nói dân đầm tự chọn lấy cái chết."])
shop_enabled = false
tint = Color(0.9, 0.95, 1, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
"action": "work",
