[node name="NPC_ChuQuan" parent="." instance=ExtResource("7_npc")]
position = Vector2(-330, -85)
npc_id = "chu_quan"
display_name = "Chủ quán Liên Hoa"
quest_ids = Array[String](["dong_02_ham_ruou", "dong_03_chuot_chua", "dong_side_herb"])
shop_enabled = true
tint = Color(1, 0.85, 0.85, 1)
dialogue_before = Array[String](["Quán Liên Hoa lúc nào cũng có phòng và rượu ngon — trừ khi chuột phá Elmford Cellar của ta!", "Xuống Elmford Cellar dưới quán, dẹp lũ chuột giúp ta trước đã. Cầu thang ngay trong quán này."])
dialogue_active = Array[String](["Elmford Cellar ở ngay dưới quán. Nghe nói còn một con Rat King to lắm ở kho sâu..."])
dialogue_ready = Array[String](["Hết chuột rồi sao? Mũi ta không còn ngửi thấy mùi hôi nữa!"])
dialogue_done = Array[String](["Cần nghỉ ngơi hay mua đồ, cứ ghé quán Liên Hoa. Thảo dược quanh Barleyfield cũng tốt cho thuốc của quán lắm."])
[node name="NPC_ThoRen" parent="." instance=ExtResource("7_npc")]
position = Vector2(430, -85)
npc_id = "tho_ren"
display_name = "Thợ rèn Đạt"
quest_ids = Array[String](["dong_side_slime"])
shop_enabled = false
tint = Color(0.9, 0.9, 0.95, 1)
dialogue_before = Array[String](["Slime cỏ tràn ra ruộng ở Barleyfield, ăn hết lúa non. Dẹp giúp ta 5 con, ta trả công hậu."])
dialogue_active = Array[String](["Slime ở ruộng phía nam thành, qua Barleyfield là thấy."])
dialogue_ready = Array[String](["Ruộng yên rồi à? Tay nghề ngươi khá đấy!"])
dialogue_done = Array[String](["Kiếm cùn thì mang qua đây, ta mài cho."])
[node name="NPC_LinhGac" parent="." instance=ExtResource("7_npc")]
position = Vector2(62, -672)
npc_id = "linh_gac"
display_name = "Lính gác cổng Bắc"
quest_ids = Array[String](["dong_04_golem"])
shop_enabled = false
tint = Color(0.8, 0.85, 1, 1)
dialogue_before = Array[String](["Trên Cloudpeak có hang Moss Den — con golem canh trong hang đã làm bị thương hai lính gác.", "Nếu ngươi đủ gan, lên núi theo cổng bắc này, vào hang ở sườn đông mà dẹp nó."])
dialogue_active = Array[String](["Đường leo núi gấp khúc, hai bên là vách đá. Cứ men theo đường đất sáng là tới miệng hang golem."])
dialogue_ready = Array[String](["Ngươi thật sự hạ được Mossback sao? Cả thành này nợ ngươi một chén rượu!"])
dialogue_done = Array[String](["Cloudpeak Summit nhìn rõ Sigilspire lắm. Người già nói rồng sẽ đáp xuống đó một ngày kia..."])
