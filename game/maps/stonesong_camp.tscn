dialogue_done = Array[String](["Hội đồng nói Vesskar là quái vật ăn caravan. Nhưng tổ tiên ta chôn cùng bia đá nói khác: nó canh cổng, và kẻ phá thề mới là kẻ đáng sợ.", "Nếu ngươi gặp nó, hãy nhìn vào mắt trước khi rút kiếm."])
