[node name="NPC_PhapSuDaVang" type="CharacterBody2D" parent="." instance=ExtResource("17_roudh")]
y_sort_enabled = true
position = Vector2(288, -64)
script = ExtResource("18_auop6")
npc_id = "phap_su_da_vang"
display_name = "Pháp Sư Bộ Lạc Đá Vang"
quest_ids = Array[String](["tay_03b_da_vang", "tay_side_bones"])
dialogue_before = Array[String](["Đá Vang không tin lời hứa. Vào Buried Sand Ruins ở phía đông Redrock Canyon, đứng trước bia lời thề trong đền cát — rồi quay lại, mắt ngươi sẽ tự nói thật hay giả.", "Xương khô quanh trại cũng đang nghe tiếng cổng phong ấn yếu đi. Dọn chúng nếu ngươi muốn giúp thêm."])
dialogue_active = Array[String](["Tàn tích ở phía đông hẻm núi. Phòng đền ở phía bắc tàn tích — nơi Vesskar từng quỳ xuống thề."])
dialogue_ready = Array[String](["Ngươi đã đứng trước bia lời thề. Đá trong xương ta nghe thấy điều đó. Đá Vang gia nhập liên minh."])
dialogue_done = Array[String](["Lời thề của Vesskar không phải xiềng xích của hội đồng. Nó là giao ước canh cổng — và giao ước thì có thể trả, không nhất thiết phải giết người giữ."])
shop_enabled = false
tint = Color(0.78, 0.7, 1, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
"action": "work",
"time": 9.0,
"x": 288.0,
