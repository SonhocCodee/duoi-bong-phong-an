[node name="NPC_VuaBacBang" type="CharacterBody2D" parent="." instance=ExtResource("15_ccrrl")]
y_sort_enabled = true
position = Vector2(32, -1536)
script = ExtResource("16_67h5v")
npc_id = "vua_bac_bang"
display_name = "King Valdemar (tên đề xuất) — Vua Băng Bị Nguyền"
quest_ids = Array[String](["bac_06_ke_giu_nguyen", "bac_07a_giai_thoat"])
dialogue_before = Array[String](["...Ca gác... chưa hết ca gác. Kẻ Giữ Nguyền còn đứng giữa sân kia — chừng nào nó còn giữ sổ nguyền, chừng đó ta còn phải ngồi đây thi hành một mệnh lệnh đã chết cùng người ra lệnh.", "Ngươi đánh nó, không phải đánh ta. Nhớ lấy điều đó, hiệp sĩ sống."])
dialogue_active = Array[String](["Đạn Băng của nó bay theo loạt. Hiệp sĩ hai bên ngai của ta đã bị nguyền kéo cạn ký ức rồi — chúng không còn 'đang nhớ' nữa đâu."])
dialogue_ready = Array[String](["Nguyền... vỡ rồi. Lần đầu tiên sau mấy trăm năm, ta nghe thấy im lặng. Ngươi mang tên các đội trưởng tới chứ? Đọc chúng lên bên chiếc chuông câm — đọc cả tên ta nữa. Ta muốn ra đi như một người có tên, không phải như một cái ngai.", "Cảm ơn ngươi. Nói với bà góa giữ danh sách: ca gác cuối cùng đã xong. Mọi người được về nhà rồi."])
dialogue_done = Array[String](["...Gió Bắc hôm nay nhẹ. Quân đoàn ngủ yên. Ngươi đi tiếp đi — tháp ở giữa thế gian kia còn nợ nhiều người một lời giải thích hơn ta nhiều."])
shop_enabled = false
tint = Color(0.6, 0.8, 1, 1)
sprite_scale = 0.75
wander_radius = 0.0
wander_speed = 30.0
schedule = Array[Dictionary]([])
schedule_enabled = false
work_anim = "work"
speed = 55.0

