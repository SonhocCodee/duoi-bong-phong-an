[node name="NPC_VuaDinhThap" type="CharacterBody2D" parent="." instance=ExtResource("6_ssebd")]
y_sort_enabled = true
position = Vector2(864, -896)
script = ExtResource("7_mmlbs")
npc_id = "vua_dinh_thap"
display_name = "Vua Trên Đỉnh Tháp"
quest_ids = Array[String](["thap_04_vua_dinh_thap"])
dialogue_before = Array[String](["(Vua không ngồi ngai. Hắn đứng cạnh Bệ Phong Ấn, và trông... mệt. Mệt như một người đã kéo bốn sợi dây rối suốt mấy chục năm không được ngủ.)", "Ta biết ngươi nghĩ gì: kẻ điều khiển bốn vua bù nhìn, tên bạo chúa trên đỉnh tháp. Đúng một nửa. Nửa còn lại: ấn này ĂN lời thề bị phản bội, hiệp sĩ. Muốn nó không đói đến mức phá neo, ta phải KIỂM SOÁT mọi lời thề trong vương quốc — qua bốn con rối, bốn triều đình giả. Ta không cai trị vì tham. Ta cai trị vì cái neo là một CÔ GÁI, và ta không chịu nổi ý nghĩ để cô ấy gánh một mình thêm một đời nữa.", "Kế hoạch của ta: phá ấn có kiểm soát, thả thứ bị giam ra theo điều kiện, và giải thoát Seraphine. Ngươi đến phá hỏng gần hết bộ máy của ta rồi — giỏi. Giờ thì hoặc ngươi để ta hoàn tất... hoặc ngươi đánh bại ta và TỰ GÁNH quyết định đó ở Bệ Phong Ấn. Ta không nhường quyết định này cho kẻ chưa nghe hết sự thật — may cho ngươi, ngươi nghe hết rồi."])
dialogue_active = Array[String](["Đạn của ta không nương tay đâu — cả Chỉ Ấn lẫn băng của phương Bắc. Và khi ấn nứt ở phase cuối, mặt đất dưới chân ngươi cũng thành vũ khí. Né vòng sáng tím, hiệp sĩ."])
dialogue_ready = Array[String](["...Dây rối đứt rồi. Bệ Phong Ấn là của ngươi. Chọn cho tử tế vào — ta đã chọn hộ vương quốc này quá lâu, và ngươi thấy kết quả rồi đấy."])
dialogue_done = Array[String](["Vương quốc không còn vua trên đỉnh nữa. Nó có một Bệ Phong Ấn và một người đã dám tự quyết. Thế là đủ hơn ta từng dám mơ."])
shop_enabled = false
tint = Color(0.9, 0.75, 0.45, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([])
