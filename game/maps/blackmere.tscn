[node name="NPC_TruongDanChai" type="CharacterBody2D" parent="." instance=ExtResource("21_0wl5o")]
y_sort_enabled = true
position = Vector2(1568, -64)
script = ExtResource("22_vyn32")
npc_id = "truong_dan_chai_ho"
display_name = "Trưởng Dân Chài Blackmere"
quest_ids = Array[String](["nam_04_duong_thuy", "nam_05_den_chim_trieu", "nam_06b_giu_trieu_moi"])
dialogue_before = Array[String](["Dân chài ta giấu một chuyện: triều ở Fenmire không tự dâng. Có người giữ nó — và không phải giáo phái.", "Dọn giúp ta bầy Đỉa Bùn chắn đường thủy phía bắc hồ, ta mở đường và kể hết phiên bản của Người Giữ Triều."])
dialogue_active = Array[String](["Đỉa ở vùng nước tù phía bắc hồ, có cả con Đỉa Chúa to như cái xuồng. Dọn xong quay lại đây."])
dialogue_ready = Array[String](["Đường thủy thông rồi. Nghe cho kỹ đây — chứng cứ C: tên các đời Người Giữ Triều khắc dưới mực nước trong đền, giáo phái chỉ là kẻ đến sau chiếm lấy triều."])
dialogue_done = Array[String](["Vào đền lúc triều rút, đọc tên khắc dưới nước, rồi đối mặt Morvain. Dân chài đứng sau ngươi — nếu ngươi chọn con đường giữ triều."])
shop_enabled = false
tint = Color(0.85, 0.9, 1, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
