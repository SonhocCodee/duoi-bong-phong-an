dialogue_before = Array[String](["Cá sấu ăn đêm ở bến nam, hai con. Dân ta không dám ra khơi từ dạo ấy. Dẹp giúp, ta trả cá khô cả tháng."])
dialogue_active = Array[String](["Bến phía nam hồ, chỗ nước đen nhất. Nghe tiếng táp nước là nó đấy."])
dialogue_ready = Array[String](["Bến yên rồi! Đêm nay cả làng ra khơi lại."])
dialogue_done = Array[String](["Cá chết nổi vòng tròn hướng về đền — ngươi thấy chưa? Hồ này đang nhìn về phía triều bị giữ."])
