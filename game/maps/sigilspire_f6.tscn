[node name="NPC_Seraphine" type="CharacterBody2D" parent="." instance=ExtResource("7_rgr1g")]
y_sort_enabled = true
position = Vector2(32, -576)
script = ExtResource("8_8necf")
npc_id = "seraphine"
display_name = "Công chúa Seraphine"
quest_ids = Array[String](["thap_03_seraphine"])
dialogue_before = Array[String](["Ngươi đến thật à. Bao nhiêu hiệp sĩ trong truyện cổ tích 'đến cứu công chúa'... mà chưa ai hỏi công chúa xem cô ấy đang GIỮ cái gì.", "Ta là vật phong ấn sống, hiệp sĩ. Phong ấn của vương quốc này không nằm trong đá — nó nằm trong NGƯỜI. Ta là cái neo. Nếu ngươi 'cứu' ta ra khỏi tháp này theo cách thông thường, ấn mất neo và vỡ tung — thứ bị giam sẽ tràn ra khắp bốn vùng trong một đêm.", "Vua ở đỉnh tháp không hẳn là ác nhân trong truyện của ngươi đâu. Hắn điều khiển bốn vua bù nhìn, đúng. Nhưng hắn cũng đang cố phá ấn CÓ KIỂM SOÁT — để ta được tự do, và để vương quốc không phải trả giá bằng một con người nữa. Cái giá của cách đó... ngươi sẽ nghe chính hắn nói.", "Lên đỉnh đi. Đánh bại hắn nếu phải đánh. Rồi TỰ NGƯƠI quyết định ở Bệ Phong Ấn: giữ ấn theo cách mới, phá ấn theo cách của hắn, hay... ngồi vào chỗ của ta. Ta không xin ngươi chọn cách nào. Ta chỉ xin ngươi đừng chọn như một nhân vật trong truyện."])
dialogue_active = Array[String](["Cổng lên đỉnh chỉ mở cho người đã nghe hết sự thật. Ngươi nghe rồi đấy. Đi đi."])
dialogue_ready = Array[String](["Ngươi hiểu rồi. Tốt. Dù ngươi chọn gì ở Bệ Phong Ấn — cảm ơn vì đã hỏi ta trước. Chưa từng có ai hỏi cả."])
dialogue_done = Array[String](["Dù kết cục nào... lần đầu tiên trong đời, ta thấy hồi hộp về ngày mai. Cảm giác lạ thật. Đi đi, hiệp sĩ của bốn vùng đất."])
shop_enabled = false
tint = Color(0.95, 0.85, 0.6, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([])
schedule_enabled = false
work_anim = "work"
speed = 55.0

