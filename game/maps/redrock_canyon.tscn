quest_ids = Array[String](["tay_05_dau_truong"])
dialogue_before = Array[String](["Đấu trường này chỉ mở cho kẻ có liên minh đứng sau. Kassia Vane không đánh với kẻ vô danh không ai chứng kiến.", "Khi hai bộ lạc đã gật đầu, quay lại đây. Ta sẽ mở cổng cát."])
dialogue_active = Array[String](["Kassia đang ở giữa đấu trường. Khiên của cô ta chỉ sợ đòn từ sau lưng — và sợ khán giả quay lưng còn hơn."])
dialogue_ready = Array[String](["Cô ta gục rồi... Hội đồng mất đấu trường, mất mặt, và sắp mất cả Solmaris."])
dialogue_done = Array[String](["Ta bán vé cả đời, chưa thấy ngày nào khán giả đứng dậy vì một kẻ ngoài vùng như hôm nay."])
