[node name="NPC_BaGoaGiuTen" type="CharacterBody2D" parent="." instance=ExtResource("23_pcs58")]
y_sort_enabled = true
position = Vector2(-480, 416)
script = ExtResource("24_ul5cw")
npc_id = "ba_goa_giu_ten"
display_name = "Bà Góa Giữ Danh Sách"
quest_ids = Array[String](["bac_04_ten_doi_truong", "bac_05_tram_gac_ma", "bac_07b_pha_vua"])
dialogue_before = Array[String](["Ta giữ danh sách tên những người đi gác băng không về. Chồng ta ở dòng đầu tiên. Muốn giải thoát cho họ, phải gọi đúng tên — xuống Hầm Mộ Quân Đoàn đọc bia 5 đội trưởng cho ta.", "Ysolde, Bram, Odric, Sigrun, Tomas — ta thuộc lòng, nhưng nghi lễ cần người sống tận mắt đọc bia rồi mang tên về."])
dialogue_active = Array[String](["Hầm mộ ở phía đông Ghostwatch Post. Đọc đủ tên 5 đội trưởng, rồi tính chuyện trạm gác ma — hiệp sĩ ở đó quên cả tên khắc trên khiên của chính mình."])
dialogue_ready = Array[String](["Ngươi mang đủ tên về rồi... Vậy là họ vẫn còn là người, không phải chỉ là 'quân đoàn ma' như người ta gọi."])
dialogue_done = Array[String](["Dù kết cục thế nào, danh sách này từ nay đóng lại được rồi. Cảm ơn ngươi đã không để họ ra đi vô danh."])
shop_enabled = false
tint = Color(0.82, 0.78, 0.9, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
