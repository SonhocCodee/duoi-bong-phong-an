[node name="NPC_DoiTruongGacLang" type="CharacterBody2D" parent="." instance=ExtResource("23_pcs58")]
y_sort_enabled = true
position = Vector2(736, -224)
script = ExtResource("24_ul5cw")
npc_id = "doi_truong_gac_lang"
display_name = "Đội Trưởng Gác Làng"
quest_ids = Array[String](["bac_03_giu_tuong_dem"])
dialogue_before = Array[String](["Đêm xuống là Wight lại về. Người chết trong bão tuyết ở đây không nằm yên — chúng nhớ đường về tường làng. Diệt 5 con Wight quanh làng, trạm gác và đường lên thành, đêm nay dân mới ngủ được.", "Đừng coi thường chúng: wight không biết sợ, cũng không biết mệt. Ngươi thì có cả hai."])
dialogue_active = Array[String](["Wight ở góc xa của làng, quanh Ghostwatch Post và Frostgard Approach. Đánh ban ngày vẫn hơn chờ chúng tới ban đêm."])
dialogue_ready = Array[String](["Tường đứng vững qua đêm nay là nhờ ngươi. Ca gác này ghi tên ngươi vào sổ."])
dialogue_done = Array[String](["Ngươi giữ tường một đêm đã mệt thế này. Tưởng tượng giữ mấy trăm năm như quân đoàn trên kia xem."])
shop_enabled = false
tint = Color(0.7, 0.8, 0.95, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
