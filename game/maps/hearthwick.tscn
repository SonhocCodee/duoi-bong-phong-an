[node name="NPC_ChuLoSuoi" type="CharacterBody2D" parent="." instance=ExtResource("23_pcs58")]
y_sort_enabled = true
position = Vector2(352, 288)
script = ExtResource("24_ul5cw")
npc_id = "chu_lo_suoi"
display_name = "Chủ Lò Sưởi Hearthwick"
quest_ids = Array[String](["bac_02_lo_suoi"])
dialogue_before = Array[String](["Lò này cháy liên tục mấy đời rồi. Đêm nay bão to, ta cần thảo lửa chống lạnh — thứ cỏ đỏ mọc quanh làng và mép rừng thông. Thu đủ 4 cây mang về đây.", "Lò tắt một đêm thôi là sáng ra có nhà không ai mở cửa nữa. Ở Bắc, lạnh giết chậm hơn quái, nhưng chắc hơn."])
dialogue_active = Array[String](["Thảo lửa quanh làng và bìa Snowpine Forest. Nhặt đủ rồi quay lại, đừng để ta phải đi tìm ngươi trong bão."])
dialogue_ready = Array[String](["Đủ thảo lửa rồi! Đêm nay cả làng ngủ ấm. Ngươi vừa cứu nhiều mạng hơn ngươi tưởng đấy."])
dialogue_done = Array[String](["Từ nay lò này có phần công của ngươi. Người Bắc nhớ ơn bằng củi và canh nóng, không bằng lời hoa hòe."])
shop_enabled = false
tint = Color(1, 0.72, 0.5, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
