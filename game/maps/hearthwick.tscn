[node name="NPC_ThoSanDauDan" type="CharacterBody2D" parent="." instance=ExtResource("23_pcs58")]
y_sort_enabled = true
position = Vector2(-928, 224)
script = ExtResource("24_ul5cw")
npc_id = "tho_san_dau_dan"
display_name = "Thợ Săn Đầu Đàn"
quest_ids = Array[String](["bac_side_hunt"])
dialogue_before = Array[String](["Quái Băng quanh Frozen Lake vỡ ra là nổ băng — săn chúng phải tính cả đòn chết của chúng. Hạ 3 con rồi về đây lĩnh thưởng.", "Săn quái để sống còn dễ chấp nhận hơn bị chọn đi gác băng cho một phong ấn không ai giải thích. Nhớ lấy điều đó."])
dialogue_active = Array[String](["Quái Băng ở hồ đông và rừng thông. Kết liễu xong thì lùi ngay, đừng đứng ngắm lõi băng vỡ."])
dialogue_ready = Array[String](["Ba lõi băng! Da tuyết và nanh đổi được khối củi đấy. Tay săn của ngươi được làng này công nhận rồi."])
dialogue_done = Array[String](["Lần sau đi săn, cứ tới tìm ta. Người Bắc không bỏ thợ săn giỏi lại phía sau trong bão."])
shop_enabled = false
tint = Color(0.85, 0.9, 0.8, 1)
