[node name="NPC_TruongLangLoSuoi" type="CharacterBody2D" parent="." instance=ExtResource("23_pcs58")]
y_sort_enabled = true
position = Vector2(-352, -352)
script = ExtResource("24_ul5cw")
npc_id = "truong_lang_lo_suoi"
display_name = "Trưởng Làng Lò Sưởi"
quest_ids = Array[String](["bac_01_den_phuong_bac"])
dialogue_before = Array[String](["Ngươi là người của caravan sao? Sói Tuyết chặn đường Northgate từ đầu mùa rồi — dọn 4 con quanh cổng, làng này mới dám mở cửa đón ngươi.", "Ở Bắc, khách lạ không phải là gánh nặng. Khách lạ là thêm một đôi tay giữ lò, giữ tường."])
dialogue_active = Array[String](["Sói ở quanh Northgate và mép đường phía nam. Nghe tiếng tru theo bầy là biết chúng không đi một mình."])
dialogue_ready = Array[String](["Đường sạch rồi! Hearthwick mở lò đón ngươi. Ngồi xuống hong khô người đã."])
dialogue_done = Array[String](["Lò cháy được là nhờ ngươi. Giờ giữ cho nó đừng tắt — việc đó khó hơn dọn sói nhiều."])
shop_enabled = false
tint = Color(0.9, 0.8, 0.65, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
