[node name="NPC_ThuLinhDieuCat" type="CharacterBody2D" parent="." instance=ExtResource("17_4i56d")]
y_sort_enabled = true
position = Vector2(288, -64)
script = ExtResource("18_xy0qv")
npc_id = "thu_linh_dieu_cat"
display_name = "Thủ Lĩnh Bộ Lạc Diều Cát"
quest_ids = Array[String](["tay_03a_dieu_cat"])
dialogue_before = Array[String](["Diều Cát không bán lòng trung thành. Có năm tên lính đánh thuê đào ngũ cướp đoàn săn của ta ở Redrock Canyon — dọn chúng, rồi hãy nói chuyện liên minh.", "Đừng giết vì giận. Giết để sa mạc biết từ nay ai cướp của bộ lạc cũng phải trả."])
dialogue_active = Array[String](["Năm tên đào ngũ vẫn giữ khiên hội đồng ở Redrock Canyon. Lính Đánh Thuê thường cũng được tính là đồng bọn của chúng trong mắt bộ lạc."])
dialogue_ready = Array[String](["Cát đã kể lại việc ngươi làm. Diều Cát đứng cùng liên minh."])
dialogue_done = Array[String](["Khi trống đấu trường nổi lên, đàn diều của ta sẽ bay trên Redrock. Kassia sẽ thấy khán giả hôm đó không còn của riêng hội đồng."])
shop_enabled = false
tint = Color(1, 0.72, 0.48, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
