[node name="NPC_NguoiGhiAn" type="CharacterBody2D" parent="." instance=ExtResource("7_12d7o")]
y_sort_enabled = true
position = Vector2(32, -576)
script = ExtResource("8_38vty")
npc_id = "nguoi_ghi_an"
display_name = "Người Ghi Ấn Cuối Cùng"
quest_ids = Array[String](["thap_02_tang_su_an"])
dialogue_before = Array[String](["Ta là Người Ghi Ấn Cuối Cùng. Việc của ta: ghi lại mọi đời phong ấn, để không đời nào được giả vờ mình là đời đầu tiên.", "Nghe cho hết, hiệp sĩ: phong ấn này không giam một con quái vật vô danh. Nó giam THỨ ĐÃ ĂN LỜI THỀ của vương quốc đầu tiên — một thực thể lớn lên bằng từng lời thề bị phản bội. Mỗi vua bù nhìn, mỗi trạm thuế, mỗi liều thuốc bị giấu... đều là thức ăn của nó.", "Và người giữ cho nó không tràn ra, suốt bao đời nay, là một VẬT PHONG ẤN SỐNG: một con người làm neo. Đời này, neo đó là Công chúa Seraphine. Cô ấy ở tầng trên. CÒN SỐNG — theo cách mà cái neo còn sống."])
dialogue_active = Array[String](["Lên tầng 6 đi. Nghe chính cô ấy nói, trước khi ngươi quyết định thay cả vương quốc."])
dialogue_ready = Array[String](["Giờ thì ngươi biết hết rồi. Ta ghi vào sử: 'Đời phong ấn này, có một hiệp sĩ leo lên đỉnh tháp với đầy đủ sự thật trong tay — lần đầu tiên.' Lên đi. Đừng để cô ấy chờ thêm một đời nữa."])
dialogue_done = Array[String](["Sử Ấn vẫn đang được viết. Trang cuối cùng... ta để trống cho ngươi."])
shop_enabled = false
tint = Color(0.85, 0.8, 0.7, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([])
schedule_enabled = false
work_anim = "work"
speed = 55.0

