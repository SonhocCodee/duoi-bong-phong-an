[node name="NPC_HuongDan" type="CharacterBody2D" parent="." instance=ExtResource("27_6wyck")]
y_sort_enabled = true
position = Vector2(-352, -352)
script = ExtResource("28_mnoec")
npc_id = "huong_dao_oc_dao"
display_name = "Hướng Dẫn Caravan"
quest_ids = Array[String](["tay_01_den_solmaris"])
dialogue_before = Array[String](["Caravan qua được Westgate là nhờ ngươi dọn bọ cạp đấy. Diệt đủ 4 con Bọ Cạp Cát quanh cổng và Dunefield rồi quay lại đây.", "Solmaris không có vua đâu — vua chết lâu rồi. Hội đồng lính đánh thuê nói thay ngai trống, còn ai thật sự giữ vùng này thì ngươi sẽ tự thấy."])
dialogue_active = Array[String](["Bọ cạp nấp ở mép đụn quanh Westgate và phía tây Dunefield. Nghe cát sủi là lùi ngay."])
dialogue_ready = Array[String](["Đường caravan sạch rồi! Sunwell Oasis mở nước đón ngươi."])
dialogue_done = Array[String](["Muốn đi tiếp thì giữ nước cho ốc đảo trước. Ở sa mạc, liên minh bắt đầu bằng một ngụm nước chia đúng người."])
shop_enabled = false
tint = Color(1, 0.88, 0.68, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([{
"action": "idle",
"time": 5.0,
"x": -352.0,
"y": -352.0
}, {
"action": "walk",
"time": 5.0,
