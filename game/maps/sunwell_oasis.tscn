[node name="NPC_TruongLienMinh" type="CharacterBody2D" parent="." instance=ExtResource("27_6wyck")]
y_sort_enabled = true
position = Vector2(32, -544)
script = ExtResource("28_mnoec")
npc_id = "truong_lien_minh"
display_name = "Trưởng Liên Minh Sa Mạc"
quest_ids = Array[String](["tay_04_lien_minh", "tay_07a_danh_vesskar", "tay_07b_dam_phan_vesskar"])
dialogue_before = Array[String](["Ta không có ngai, không có quân thường trực. Ta chỉ có lời của hai bộ lạc — nếu ngươi lấy được cả hai.", "Diều Cát cần thấy ngươi dọn lính đào ngũ. Đá Vang cần bằng chứng lời thề trong tàn tích. Xong cả hai, quay lại đây đốt lửa liên minh."])
dialogue_active = Array[String](["Lửa liên minh chưa đốt được khi mới có một nửa sa mạc đứng sau ngươi."])
dialogue_ready = Array[String](["Ngươi đã thấy Vesskar và vẫn quay lại hỏi ý liên minh. Vậy lựa chọn là của ngươi: giết kẻ canh cổng, hay trả lại lời thề cho nó?"])
dialogue_done = Array[String](["Chìa Vảy Cát đã về tay ngươi. Dù Vesskar sống hay chết, Solmaris từ hôm nay không còn quỳ trước hội đồng nữa."])
shop_enabled = false
tint = Color(0.95, 0.78, 0.55, 1)
