[node name="NPC_GiuNuoc" type="CharacterBody2D" parent="." instance=ExtResource("27_6wyck")]
y_sort_enabled = true
position = Vector2(544, 288)
script = ExtResource("28_mnoec")
npc_id = "nguoi_giu_nuoc"
display_name = "Người Giữ Nước Sunwell"
quest_ids = Array[String](["tay_02_nuoc_oc_dao", "tay_side_vulture"])
dialogue_before = Array[String](["Rắn Cát chui vào mạch ngầm rồi. Diệt 4 con quanh ốc đảo và Dunefield, nước mới trong lại.", "Kền kền rình caravan cũng là việc của ta phải nhờ ngươi sau này."])
dialogue_active = Array[String](["Rắn hay nằm ở bờ nam ốc đảo và các hốc cát Dunefield. Đừng đứng yên trên cát mềm."])
dialogue_ready = Array[String](["Nước trong lại rồi! Cả thị trấn này nhớ ơn ngươi."])
dialogue_done = Array[String](["Hội đồng giữ tháp nước ở Solmaris, nhưng mạch nước này là của dân. Nhớ lấy khác biệt đó khi ngươi gặp họ."])
shop_enabled = false
tint = Color(0.65, 0.9, 1, 1)
