[node name="NPC_ThayDiem" type="CharacterBody2D" parent="." instance=ExtResource("16_f7cnx")]
y_sort_enabled = true
position = Vector2(-3104, -1472)
script = ExtResource("17_oxi6n")
npc_id = "thay_diem"
display_name = "Thầy Điềm Bờ Hồ"
quest_ids = Array[String](["bac_side_wraith"])
dialogue_before = Array[String](["Cực quang dạo này hiện cả ban ngày — điềm phong ấn yếu đi, người già bảo thế. Hồn Ma Băng lướt trên mặt hồ làm dân không dám qua. Dẹp 3 con rồi quay lại đây.", "Đứng trên băng mà nghe tiếng nứt xa... đó là hồ đang thở, hoặc là thứ gì dưới hồ đang cựa mình."])
dialogue_active = Array[String](["Hồn ma lướt nhanh lắm, chúng lao vào ngươi theo kiểu wyvern. Đừng đứng giữa hồ trống trải mà không có đường lùi."])
dialogue_ready = Array[String](["Mặt hồ yên lại rồi. Đêm nay cực quang chắc sẽ chỉ đẹp, không dọa người nữa."])
dialogue_done = Array[String](["Ngươi đi trên băng nhẹ như người Bắc chính gốc vậy. Ít khách phương xa làm được thế."])
shop_enabled = false
tint = Color(0.78, 0.82, 1, 1)
