[node name="NPC_TiengVuaQuaAn" type="CharacterBody2D" parent="." instance=ExtResource("6_m2gqq")]
y_sort_enabled = true
position = Vector2(32, -224)
script = ExtResource("7_ekwic")
npc_id = "tieng_vua_qua_an"
display_name = "Tiếng Vua Qua Ấn"
quest_ids = Array[String]([])
dialogue_before = Array[String](["(Một giọng nói vang ra từ chính những viên đá của tháp — không già, không trẻ, và biết tên ngươi.)", "Cuối cùng cũng có một kẻ mang đủ bốn chìa. Ta đã xem ngươi đi qua cả bốn vùng, hiệp sĩ. Ngươi giải phóng giỏi lắm. Giỏi đến mức... ta bắt đầu lo cho kế hoạch của chính mình.", "Lên đi. Tầng 6 có người ngươi muốn gặp. Tầng 7 có ta. Giữa hai tầng đó — là toàn bộ sự thật của vương quốc này, xếp theo chiều cao."])
dialogue_active = Array[String](["Đừng dừng ở sảnh. Những thứ canh tháp này không phải người của ta — chúng là của THÁP. Ấn tự vệ đấy."])
dialogue_ready = Array[String](["Ngươi đã biết hết rồi mà vẫn leo tiếp. Tốt. Ta chờ ở đỉnh."])
dialogue_done = Array[String](["..."])
shop_enabled = false
tint = Color(0.9, 0.8, 0.55, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([])
schedule_enabled = false
work_anim = "work"
speed = 55.0

