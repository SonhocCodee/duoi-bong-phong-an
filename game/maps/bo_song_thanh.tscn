dialogue_done = Array[String](["Sông Clearwater mùa này nước xiết, cá trốn hết xuống vực sâu.", "Lính thuế trên cầu thu mỗi người qua một đồng — lệnh của Vua, ai cãi là bị trói.", "Muốn tránh thuế thì... thôi, ta không nói đâu. Mạng ta còn quý."])

