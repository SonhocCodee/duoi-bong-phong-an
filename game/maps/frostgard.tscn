dialogue_before = Array[String]([])
dialogue_active = Array[String]([])
dialogue_ready = Array[String]([])
dialogue_done = Array[String](["Thép băng tôi trong nước hồ đóng băng, lưỡi không mẻ khi chém vào đá đen. Cần vũ khí hay giáp thì cứ xem hàng.", "Một nửa thép rèn ra ở đây không bán — nó đi thẳng lên tường Bắc cho ca gác đêm."])
