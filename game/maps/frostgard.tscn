[node name="NPC_TuSiKhongChuong" type="CharacterBody2D" parent="." instance=ExtResource("32_cxq1j")]
y_sort_enabled = true
position = Vector2(-4832, -2784)
script = ExtResource("33_076wd")
npc_id = "frost_tu_si"
display_name = "Tu sĩ Không Chuông — Einar"
quest_ids = Array[String]([])
dialogue_before = Array[String]([])
dialogue_active = Array[String]([])
dialogue_ready = Array[String]([])
dialogue_done = Array[String](["Nhà nguyện này không có chuông. Chuông vẫn treo ở Hầm Mộ Quân Đoàn — mà không, nó không treo nữa. Nó câm rồi, từ đêm lời nguyền rơi xuống.", "Tháp chuông trong thành này cũng trống như tim ta những năm đầu. Người ta quen dần với cả sự im lặng, hiệp sĩ ạ."])
