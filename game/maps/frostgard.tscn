[node name="NPC_DoiTruongGacBac" type="CharacterBody2D" parent="." instance=ExtResource("32_cxq1j")]
y_sort_enabled = true
position = Vector2(32, -4384)
script = ExtResource("33_076wd")
npc_id = "frost_doi_truong_gac"
display_name = "Đội trưởng ca gác — Freya"
quest_ids = Array[String]([])
dialogue_before = Array[String]([])
dialogue_active = Array[String]([])
dialogue_ready = Array[String]([])
dialogue_done = Array[String](["Ca của ta đi dọc tường Bắc, từ tháp Tây sang tháp Đông. Ngoài kia là đất chết dần về phía Sigilspire — ban đêm đừng nhìn lâu quá.", "Cổng Bắc đóng băng rồi, đừng cố. Muốn ra đất chết thì phải chờ nguyền này vỡ trước."])
