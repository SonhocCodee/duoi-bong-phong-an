[node name="NPC_GiuDaiDanhSach" type="CharacterBody2D" parent="." instance=ExtResource("32_cxq1j")]
y_sort_enabled = true
position = Vector2(-5024, 352)
script = ExtResource("33_076wd")
npc_id = "frost_giu_danh_sach"
display_name = "Người giữ Đài Danh Sách — Astrid"
quest_ids = Array[String]([])
dialogue_before = Array[String]([])
dialogue_active = Array[String]([])
dialogue_ready = Array[String]([])
dialogue_done = Array[String](["Mỗi bia ở đây là một người đã đi gác băng và không về. Ta đọc tên họ mỗi sáng — người còn tên thì chưa hẳn đã mất.", "Đài Danh Sách ở giữa nghĩa trang. Khi nghi lễ giải thoát diễn ra, tên phải được đọc lên bên chuông câm. Đừng quên điều đó."])
