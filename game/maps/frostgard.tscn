[node name="NPC_ThoRenThepBang" type="CharacterBody2D" parent="." instance=ExtResource("32_cxq1j")]
y_sort_enabled = true
position = Vector2(4704, 160)
script = ExtResource("33_076wd")
npc_id = "frost_tho_ren_thep"
display_name = "Thợ rèn thép băng — Runa"
