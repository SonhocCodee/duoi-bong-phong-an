dialogue_active = Array[String]([])
dialogue_ready = Array[String]([])
dialogue_done = Array[String](["Nhà trọ của ta là nhà hiếm hoi ở khu này còn khói bếp mỗi tối. Giường gần lò nhất thì phải đặt trước — lính gác đổi ca tranh nhau cái giường đó.", "Nhà đóng băng quanh đây không phải nhà hoang từ đầu đâu. Năm nào cũng thêm một hai căn tắt đèn hẳn."])
