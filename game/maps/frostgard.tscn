dialogue_done = Array[String](["Lò Lớn này cháy từ đời ông nội ta. Ta tắt lò một đêm thôi là sáng ra nửa thành không ai mở cửa nữa.", "Đứng gần lò mà hong người đi. Ở Frostgard, ấm cũng là một loại thuốc."])
