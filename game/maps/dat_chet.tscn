[node name="NPC_TramGacTro" type="CharacterBody2D" parent="." instance=ExtResource("8_memfm")]
y_sort_enabled = true
position = Vector2(-1248, -1088)
script = ExtResource("9_ld8sy")
npc_id = "tram_gac_tro"
display_name = "Người Gác Trạm Tro"
quest_ids = Array[String]([])
dialogue_before = Array[String](["Ta gác trạm này bốn mươi năm. Kẻ lên tháp thì nhiều, kẻ xuống thì... ngươi tự đếm bia đá quanh đây mà hiểu.", "Nghe cho kỹ: qua cổng tháp là ĐIỂM KHÔNG QUAY LẠI theo nghĩa đen của nó — không phải vì cổng khóa, mà vì những gì ngươi sắp biết sẽ không cho ngươi quay lại làm người cũ nữa. Chuẩn bị bình máu, chế đồ cho tử tế ở lò rèn kia, rồi hẵng đi."])
dialogue_active = Array[String](["Lò rèn ở trạm vẫn đỏ lửa. Chế lấy ít Đại Bình Hồi Phục trước khi leo tháp — trên đó không có ai bán gì cho ngươi đâu."])
dialogue_ready = Array[String](["Ngươi đã qua cổng rồi à? Tốt. Xuống được tới đây là giỏi hơn khối người."])
dialogue_done = Array[String](["Vương quốc đổi khác rồi, hiệp sĩ. Ngươi chọn kết cục nào... thì kết cục đó cũng đã thành sự thật. Ta gác nốt ca này nữa thôi."])
shop_enabled = false
tint = Color(0.75, 0.7, 0.8, 1)
sprite_scale = 0.75
wander_radius = 24.0
wander_speed = 30.0
schedule = Array[Dictionary]([])
schedule_enabled = false
work_anim = "work"
speed = 55.0

